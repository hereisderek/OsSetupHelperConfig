alias allApp="sudo xattr -cr"
alias signApp="codesign --force --deep -s -"

fixApp() {
  if [[ -z "$@" ]]; then
    echo "Error: You must provide a path to an app."
    echo "Usage: sudo fixapp /path/to/App.app"
    return 1
  fi
  
  xattr -cr "$@"
  codesign --force --deep -s - "$@"
  echo "Success: Quarantine flag removed for $@"
}