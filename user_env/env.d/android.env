# ==========================================
# ENVIRONMENT VARIABLES & PATHS
# ==========================================

# --- Android SDK Setup ---
# Default install location for Android Studio on Mac
export ANDROID_HOME="/Volumes/private/Library/sdk"

# Add Android tools to PATH (Order matters; newer tools go first)
export PATH="$ANDROID_HOME/emulator:$PATH"
export PATH="$ANDROID_HOME/platform-tools:$PATH"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

# Dynamically find the latest build-tools version and add to PATH
if [ -d "$ANDROID_HOME/build-tools" ]; then
    LATEST_BUILD_TOOLS=$(ls "$ANDROID_HOME/build-tools" | sort -V | tail -n 1)
    export PATH="$PATH:$ANDROID_HOME/build-tools/$LATEST_BUILD_TOOLS"
fi

